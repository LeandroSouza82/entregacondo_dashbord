{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "entregacondo.com.br" }],
      "destination": "/site/index.html"
    },
    { "source": "/privacidade", "destination": "/site/privacidade.html" },
    { "source": "/termos", "destination": "/site/termos.html" },
    {
      "source": "/(.*)",
      "destination": "/dashboard.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "entregacondo.com.br" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/comprovante/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/privacidade.html", "destination": "https://entregacondo.com.br/privacidade", "permanent": true },
    { "source": "/termos.html", "destination": "https://entregacondo.com.br/termos", "permanent": true },
    { "source": "/login", "destination": "https://dashboard.entregacondo.com.br/#/login", "permanent": false },
    { "source": "/cadastro", "destination": "https://dashboard.entregacondo.com.br/#/cadastro", "permanent": false }
  ]
}
